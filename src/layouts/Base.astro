---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
interface Props { title?: string; description?: string; home?: boolean; }
const { title, description = SITE.description, home = false } = Astro.props;
const full = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="claude:viewport-fit-sides" content="cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Caveat:wght@600;700&family=JetBrains+Mono:wght@400&family=Instrument+Serif:ital@0;1&display=swap" />
</head>
<body>
  <Header />
  <main class={home ? 'is-home' : 'has-pill'}><slot /></main>
  <Footer />
</body>
</html>
