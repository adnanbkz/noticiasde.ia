---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Placeholder from '../components/Placeholder.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { AUTHOR, WORK, PROJECTS, STORY, SOCIALS, REPOS_FALLBACK } from '../data/site';
const posts = (await getCollection('articulos', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const [lead, ...rest] = posts;
const tiktok = SOCIALS.find((x) => x.id === 'tiktok')!;
const langColor: Record<string, string> = { TypeScript: '#3178c6', JavaScript: '#f1e05a', Python: '#3572A5', Astro: '#ff5a03', HCL: '#844FBA', Go: '#00ADD8', Rust: '#dea584', 'C++': '#f34b7d', Shell: '#89e051', Java: '#b07219', Kotlin: '#A97BFF', 'C#': '#178600', HTML: '#e34c26', CSS: '#663399' };
---
<Base title="Adnan" description={AUTHOR.bio}>
  <!-- Hero: el foco eres tú -->
  <section class="me">
    <div class="wrap me-in">
      <div class="me-text">
        <h1>Hola, soy <span class="me-name">Adnan.</span></h1>
        <p class="me-lead">Programo cobots, hago vídeos de IA en <a href={SOCIALS[0].url} target="_blank" rel="noopener">@noticiasde.ia</a> y estoy aprendiendo en público a ser <strong>AI & Cloud engineer</strong>.</p>
        <div class="me-actions">
          <a class="btn btn-light" href="#historia">Mi historia</a>
          <a class="btn btn-line" href="/articulos/">Leer los artículos</a>
        </div>
        <ul class="me-facts">
          <li><b>2 años</b> como software developer</li>
          <li><b>Cobots</b> en el trabajo</li>
          <li><b>{posts.length}</b> artículos escritos a mano</li>
        </ul>
      </div>
      <figure class="me-photo">
        <Placeholder img={AUTHOR.photo} label="" ratio="4/5" hint="Tu foto aquí (vertical, 4:5)" />
        <img class="me-mascot" src="/img/mascota.webp" alt="La mascota de noticiasde.ia saludando" width="240" />
        <figcaption class="note note-a">
          este soy yo
          <svg viewBox="0 0 120 60" aria-hidden="true"><path d="M4 10 C40 6 80 18 104 46" /><path d="M92 44 l13 4 -2 -13" /></svg>
        </figcaption>
        <span class="note note-b" aria-hidden="true">
          <svg viewBox="0 0 120 60"><path d="M116 50 C80 52 40 40 14 14" /><path d="M14 28 l-1 -14 13 2" /></svg>
          y él, mi mascota
        </span>
      </figure>
    </div>
  </section>

  <!-- Lo que hago -->
  <section class="work wrap" id="trabajo">
    <div class="work-photo"><Placeholder img={WORK.photo} label="" ratio="3/4" hint="Foto tuya con un cobot" /></div>
    <div class="work-text">
      <h2>{WORK.title}</h2>
      <p class="lead">{WORK.intro}</p>
      <dl class="work-facts">
        {WORK.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- Historia -->
  <section class="story" id="historia">
    <div class="wrap">
      <h2 class="section-title">Mi historia</h2>
      <p class="lead story-lead">{AUTHOR.bio}</p>
      <ol class="path">
        {STORY.map((s, i) => (
          <li class={i === 2 ? 'is-now' : i > 2 ? 'is-next' : ''}>
            <span class="path-when">{s.when}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {i === 2 && <span class="hand path-here">estoy aquí</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Proyectos -->
  <section class="wrap projects" id="proyectos">
    <h2 class="section-title">Proyectos</h2>
    {PROJECTS.map((p, i) => (
      <article class={`project ${i % 2 ? 'project-rev' : ''}`}>
        <Placeholder img={p.img} label="" ratio="16/10" hint={i === 0 ? "Captura de tus interfaces de soldadura" : "Captura del proyecto"} />
        <div class="project-text">
          <h3>{p.name}</h3>
          <p>{p.what}</p>
          <ul class="chips">{p.stack.map((t) => <li>{t}</li>)}</ul>
          {p.url && <a class="arrow-link" href={p.url} target="_blank" rel="noopener">{p.cta}</a>}
        </div>
      </article>
    ))}
  </section>

  <!-- GitHub -->
  <section class="gh" id="github">
    <div class="wrap">
      <div class="gh-head">
        <h2 class="section-title">En GitHub</h2>
        <a class="arrow-link" href={`https://github.com/${AUTHOR.github}`} target="_blank" rel="noopener">github.com/{AUTHOR.github}</a>
      </div>
      <ul class="gh-stats" id="gh-stats" aria-live="polite">
        <li><b data-k="repos">–</b>repos públicos</li>
        <li><b data-k="stars">–</b>estrellas</li>
        <li><b data-k="followers">–</b>seguidores</li>
        <li><b data-k="last">–</b>última actividad</li>
      </ul>
      <div class="gh-cal" id="gh-cal" data-user={AUTHOR.github}>
        <p class="gh-cal-title"><b data-k="contribs">–</b> contribuciones en el último año</p>
        <div class="gh-cal-scroll"><div class="gh-cal-grid" role="img" aria-label="Calendario de contribuciones en GitHub"></div></div>
        <p class="gh-cal-legend">Menos <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> Más</p>
      </div>
      <div class="repos" id="repos" data-user={AUTHOR.github}>
        {REPOS_FALLBACK.map((r) => (
          <a class="repo" href={r.url} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.71 1.71.75.75 0 0 1-1.06 1.06A2.5 2.5 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.71A2.5 2.5 0 0 1 4.5 9h8Z"/></svg>
            <strong>{r.name}</strong>
            <p>{r.description}</p>
            <span class="repo-meta"><span class="lang" style={`--l:${langColor[r.language] ?? '#999'}`}></span>{r.language}<span>★ {r.stars}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <script is:inline>
    (async () => {
      const cal = document.getElementById('gh-cal'); if (!cal) return;
      try {
        const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${cal.dataset.user}?y=last`);
        if (!res.ok) throw 0;
        const data = await res.json();
        const days = data.contributions || [];
        cal.querySelector('[data-k="contribs"]').textContent = data.total?.lastYear ?? days.reduce((n, d) => n + d.count, 0);
        const grid = cal.querySelector('.gh-cal-grid');
        const pad = days.length ? new Date(days[0].date + 'T12:00:00').getDay() : 0;
        const frag = document.createDocumentFragment();
        for (let i = 0; i < pad; i++) frag.append(document.createElement('span'));
        days.forEach((d) => { const c = document.createElement('i'); c.className = 'l' + d.level; c.title = `${d.count} el ${d.date}`; frag.append(c); });
        grid.append(frag);
        cal.classList.add('is-ready');
      } catch (e) { cal.classList.add('is-off'); }
    })();
  </script>
  <script is:inline define:vars={{ langColor }}>
    (async () => {
      const box = document.getElementById('repos'); if (!box) return;
      try {
        const user = box.dataset.user;
        const [ru, rr] = await Promise.all([fetch(`https://api.github.com/users/${user}`), fetch(`https://api.github.com/users/${user}/repos?sort=pushed&per_page=100`)]);
        if (!rr.ok) return;
        const all = (await rr.json()).filter((r) => !r.fork);
        const set = (k, v) => { const el = document.querySelector(`#gh-stats [data-k="${k}"]`); if (el) el.textContent = v; };
        if (ru.ok) { const u = await ru.json(); set('repos', u.public_repos); set('followers', u.followers); }
        set('stars', all.reduce((n, r) => n + r.stargazers_count, 0));
        if (all[0]) {
          const days = Math.round((Date.now() - new Date(all[0].pushed_at)) / 864e5);
          set('last', days <= 0 ? 'hoy' : days === 1 ? 'ayer' : `hace ${days} días`);
        }
        const repos = [...all].slice(0, 6); // los 6 con actividad más reciente
        if (!repos.length) return;
        const tpl = box.querySelector('.repo');
        box.replaceChildren(...repos.map((r) => {
          const el = tpl.cloneNode(true);
          el.href = r.html_url;
          el.querySelector('strong').textContent = r.name;
          el.querySelector('p').textContent = r.description || 'Sin descripción todavía.';
          const meta = el.querySelector('.repo-meta');
          meta.innerHTML = '';
          const dot = document.createElement('span'); dot.className = 'lang'; dot.style.setProperty('--l', langColor[r.language] || '#999');
          const star = document.createElement('span'); star.textContent = `★ ${r.stargazers_count}`;
          meta.append(dot, document.createTextNode(r.language || 'Varios'), star);
          return el;
        }));
      } catch (e) { /* se quedan los de ejemplo */ }
    })();
  </script>

  <!-- Artículos -->
  <section class="wrap latest">
    <div class="gh-head">
      <h2 class="section-title">Lo último que he escrito</h2>
      <a class="arrow-link" href="/articulos/">Todos los artículos</a>
    </div>
    <div class="latest-grid">
      <PostCard post={lead} variant="big" mascot />
      <div class="latest-list">{rest.slice(0, 4).map((p) => <PostCard post={p} variant="row" />)}</div>
    </div>
  </section>

  <!-- Redes -->
  <section class="social" id="redes">
    <div class="wrap">
      <h2 class="section-title">Donde me puedes ver</h2>
      <ul class="social-links">{SOCIALS.map((s) => (
        <li><a class={`net net-${s.id}`} href={s.url} target="_blank" rel="noopener"><span class="net-dot"></span><strong>{s.name}</strong><span>{s.handle}</span></a></li>
      ))}</ul>
      <div class="tiktok-box">
        <div class="tiktok-cta">
          <img src="/img/mascota-cara.png" alt="" width="72" height="72" />
          <h3>Mis últimos TikToks</h3>
          <p>Vídeos de un minuto explicando IA y tecnología en español. Se actualizan solos cada vez que subo uno nuevo.</p>
          <a class="btn" href={tiktok.url} target="_blank" rel="noopener">Abrir {tiktok.handle}</a>
        </div>
        <div class="tiktok-embed-wrap">
          <blockquote class="tiktok-embed" cite={tiktok.url} data-unique-id={tiktok.handle.replace('@', '')} data-embed-type="creator" style="max-width: 780px; min-width: 288px;">
            <section><a target="_blank" rel="noopener" href={`${tiktok.url}?refer=creator_embed`}>{tiktok.handle} en TikTok</a></section>
          </blockquote>
          <script is:inline async src="https://www.tiktok.com/embed.js"></script>
        </div>
      </div>
    </div>
  </section>

  <Newsletter />
</Base>
