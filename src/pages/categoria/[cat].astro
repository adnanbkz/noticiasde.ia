---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, type CatId } from '../../data/site';
export async function getStaticPaths() {
  const used = new Set((await getCollection('articulos', ({ data }) => !data.draft)).map((p) => p.data.category));
  return Object.keys(CATEGORIES).filter((cat) => used.has(cat as CatId)).map((cat) => ({ params: { cat } }));
}
const cat = Astro.params.cat as CatId; const c = CATEGORIES[cat];
const posts = (await getCollection('articulos', ({ data }) => !data.draft && data.category === cat)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title={c.name} description={c.blurb}>
  <section class="cat-hero" style={`--c:${c.color};--c2:${c.color2}`}>
    <div class="wrap"><p class="crumbs"><a href="/articulos/">Artículos</a></p><h1>{c.name}</h1><p class="count">{posts.length} artículos</p><p class="lead">{c.blurb}</p></div>
  </section>
  <section class="wrap more-posts">
    {posts.length ? (<>
      <div class="band-grid"><PostCard post={posts[0]} variant="big" mascot /><div class="band-list">{posts.slice(1, 4).map((p) => <PostCard post={p} variant="row" />)}</div></div>
      {posts.length > 4 && <div class="grid-3" style="margin-top:3rem">{posts.slice(4).map((p) => <PostCard post={p} />)}</div>}
    </>) : <p class="muted">Todavía no hay artículos aquí. Estoy escribiendo el primero.</p>}
  </section>
</Base>
