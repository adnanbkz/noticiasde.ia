---
import { SITE, SOCIALS, AUTHOR, STATS } from '../data/site';
const links = [
  { href: '/articulos/', label: 'Artículos' },
  { href: '/#hago', label: 'Lo que hago' },
  { href: '/#trayectoria', label: 'Trayectoria' },
  { href: '/#contacto', label: 'Contacto' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<footer class="ft">
  <div class="wrap">
    <div class="ft-top">
      <div class="ft-brand">
        <a class="ft-logo" href="/">noticiasde<em>.ia</em></a>
        <p>{SITE.tagline}</p>
        <ul class="ft-stats">{STATS.map((s) => <li><b>{s.value}</b><span>{s.label}</span></li>)}</ul>
      </div>
      <nav class="ft-links" aria-label="Pie de página">
        <p class="ft-eyebrow">Links</p>
        <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <ul class="ft-nets">{SOCIALS.map((s) => (
        <li><a href={s.url} target="_blank" rel="noopener">{s.name}<span class="ft-arrow" aria-hidden="true"><svg viewBox="0 0 12 12" width="11" height="11"><path d="M3 9 9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span></a></li>
      ))}</ul>
    </div>

    <div class="ft-legal">
      <span>© {new Date().getFullYear()} {AUTHOR.name} · {SITE.name}</span>
      <a href="/rss.xml">RSS</a>
      <span>Sin cookies de seguimiento</span>
      <span>Hecho con Astro</span>
    </div>
  </div>
</footer>
